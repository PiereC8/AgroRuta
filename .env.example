DB_PLATAFORMA_URL=
DB_USUARIO=
DB_CLAVE=
BD_SUFIJO=
JWT_SECRETO=
ADMIN_PLATAFORMA_USUARIO=
ADMIN_PLATAFORMA_CLAVE=

# Pasarela de pago Mercado Pago, con las credenciales de PRUEBA. Si se dejan vacías, se usa el simulador.
MERCADOPAGO_LLAVE_PUBLICA=
MERCADOPAGO_TOKEN_ACCESO=

# Proveedor de comprobantes Nubefact (ambiente de pruebas). Si se dejan vacías, se usa el simulador.
NUBEFACT_URL=
NUBEFACT_TOKEN=
NUBEFACT_AUTORIZACION=SOLO_TOKEN
COMPROBANTES_SERIE_BOLETA=B001
COMPROBANTES_SERIE_FACTURA=F001

# Correo para los avisos (por ejemplo Gmail). El usuario es la cuenta y la clave es una "contraseña de aplicación"
# de Google (no la contraseña de la cuenta). Si se dejan vacíos, los avisos se simulan y solo quedan en el historial.
CORREO_SERVIDOR=smtp.gmail.com
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE_APLICACION=
CORREO_REMITENTE=

# Cuándo avisar (opcional)
AVISOS_MERMA_ALTA_PORCENTAJE=10
AVISOS_DIAS_COBRO_VENCIDO=7
AVISOS_HORAS_COMPROBANTE_ATASCADO=24
